# Local development settings.
# Copy this file to .env (git ignores .env) and change values if you need to.
# Never put real production secrets in this file: it is committed to git.

# --- Database: Docker Postgres (see docker-compose.yml) ---
POSTGRES_USER=jbt
POSTGRES_PASSWORD=jbt
POSTGRES_DB=jbt_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jbt:jbt@localhost:5433/jbt_dev
TEST_DATABASE_URL=postgresql://jbt:jbt@localhost:5433/jbt_test

# --- Email: Mailpit catches everything locally (inbox: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
