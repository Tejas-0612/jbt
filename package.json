{
  "name": "jbt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --no-bail --if-present run dev",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "pnpm --filter @jbt/api db:generate",
    "db:migrate": "pnpm --filter @jbt/api db:migrate",
    "db:status": "pnpm --filter @jbt/api db:status",
    "db:studio": "pnpm --filter @jbt/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
